# Vercel Postgres / Neon
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Google OAuth — Cloud Console > Google Auth Platform > Clients > Web application
# Authorised redirect URI must be exactly: http://localhost:3020/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte hex key for AES-256-GCM refresh-token encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=


# Gate for the deployed app. Minimum 8 characters. Without it the app refuses
# to serve, because a public Vercel URL with no lock is open to anyone.
APP_PASSWORD=

# Your deployed origin, no trailing slash. Used to build the OAuth redirect URI.
# Local development can leave this unset.
APP_URL=https://your-app.vercel.app

# Phase 4
ANTHROPIC_API_KEY=
